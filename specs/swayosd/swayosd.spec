Name:           swayosd
Version:        0.3.2
Release:        1%{?dist}
Summary:        GTK on-screen display for keyboard shortcuts like caps-lock and volume
License:        GPL-3.0-or-later
URL:            https://github.com/ErikReider/SwayOSD
Source0:        %{url}/archive/refs/tags/v%{version}.tar.gz#/%{name}-%{version}.tar.gz
# Generated by prepare.sh (cargo vendor)
Source1:        %{name}-%{version}-vendor.tar.gz

BuildRequires:  cargo
BuildRequires:  gcc
BuildRequires:  meson
BuildRequires:  ninja-build
BuildRequires:  rust
BuildRequires:  sassc
BuildRequires:  systemd-rpm-macros
BuildRequires:  /usr/bin/glib-compile-resources
BuildRequires:  pkgconfig(dbus-1)
BuildRequires:  pkgconfig(glib-2.0)
BuildRequires:  pkgconfig(gtk4)
BuildRequires:  pkgconfig(gtk4-layer-shell-0)
BuildRequires:  pkgconfig(libevdev)
BuildRequires:  pkgconfig(libinput)
BuildRequires:  pkgconfig(libpulse)
BuildRequires:  pkgconfig(libudev)
BuildRequires:  pkgconfig(systemd)

Requires:       dbus

%description
A GTK based on-screen display (OSD) for keyboard shortcuts like caps-lock and
volume, for Wayland compositors such as Hyprland and Sway.

%prep
%autosetup -p1 -n SwayOSD-%{version}
tar xf %{SOURCE1}

# Use the system toolchain, not the nightly one pinned for rustup
rm -f rust-toolchain.toml

mkdir -p .cargo
cat > .cargo/config.toml << 'EOF'
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"

[net]
offline = true
EOF

%build
%meson --buildtype=release
%meson_build

%install
%meson_install

mkdir -p %{buildroot}%{_udevrulesdir}
mv %{buildroot}%{_libdir}/udev/rules.d/99-swayosd.rules %{buildroot}%{_udevrulesdir}/

%post
%systemd_post swayosd-libinput-backend.service

%preun
%systemd_preun swayosd-libinput-backend.service

%postun
%systemd_postun_with_restart swayosd-libinput-backend.service

%files
%license LICENSE
%doc README.md
%dir %{_sysconfdir}/xdg/swayosd
%config(noreplace) %{_sysconfdir}/xdg/swayosd/backend.toml
%config(noreplace) %{_sysconfdir}/xdg/swayosd/config.toml
%config(noreplace) %{_sysconfdir}/xdg/swayosd/style.css
%{_bindir}/swayosd-client
%{_bindir}/swayosd-libinput-backend
%{_bindir}/swayosd-server
%{_datadir}/dbus-1/system-services/org.erikreider.swayosd.service
%{_datadir}/dbus-1/system.d/org.erikreider.swayosd.conf
%{_datadir}/polkit-1/actions/org.erikreider.swayosd.policy
%{_datadir}/polkit-1/rules.d/org.erikreider.swayosd.rules
%{_udevrulesdir}/99-swayosd.rules
%{_unitdir}/swayosd-libinput-backend.service

%changelog
%autochangelog
